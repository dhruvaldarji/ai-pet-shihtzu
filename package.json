{
  "name": "louis-codex-pet",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun tools/build.ts",
    "test": "bun test tools --timeout 30000",
    "check:setup": "bun tools/check-dependencies.ts",
    "check:production": "bun test checks/production.test.ts --timeout 60000",
    "check:pr": "bun tools/pr-policy.ts",
    "check:types": "tsc --noEmit",
    "check:format": "biome format .",
    "check:lint": "biome lint --error-on-warnings .",
    "format": "biome check --write .",
    "setup:quality": "sh tools/install-quality-tools.sh",
    "check:shell": ".quality-bin/shellcheck --shell=sh install.sh uninstall.sh tools/install-quality-tools.sh tools/install-security-tools.sh",
    "check:workflows": "PATH=\"$PWD/.quality-bin:$PATH\" .quality-bin/actionlint",
    "check:quality": "bun run check:types && bun run check:format && bun run check:lint && bun run check:shell && bun run check:workflows",
    "setup:security": "sh tools/install-security-tools.sh",
    "check:security-history": "bun test checks/security.test.ts --timeout 30000",
    "check:security": "bun tools/security.ts",
    "check:dependencies": "bun audit --audit-level=high",
    "check:release": "bun test checks/release.test.ts --timeout 240000",
    "check:site": "bun test checks/site.test.ts --timeout 240000",
    "release:prepare": "bun tools/release.ts",
    "release:draft": "bun tools/release-draft.ts",
    "site:build": "bun tools/site.ts"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": "1.3.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
